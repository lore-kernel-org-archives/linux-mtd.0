+	memset(buf + len, 0xff, alen - len);
+	pad_len =3D wlen - alen;
+	dbg_msg(3, "len %d pad_len %d", len, pad_len);
+	buf +=3D alen;
+	if (pad_len >=3D (int)UBIFS_PAD_NODE_SZ) {
+		struct ubifs_ch *ch =3D buf;
+		struct ubifs_pad_node *pad_node =3D buf;
+
+		ch->magic      =3D cpu_to_le32(UBIFS_NODE_MAGIC);
+		ch->node_type  =3D UBIFS_PAD_NODE;
+		ch->group_type =3D UBIFS_NO_NODE_GROUP;
+		ch->padding[0] =3D ch->padding[1] =3D 0;
+		ch->sqnum      =3D cpu_to_le64(0);
+		ch->len        =3D cpu_to_le32(UBIFS_PAD_NODE_SZ);
