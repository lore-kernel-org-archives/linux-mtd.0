+		fprintf(stderr, "%s: no RFD blocks found\n", rfd.mtd_filename);
+		goto err;
+	}
+
+	for (i=3D0; i<rfd.sector_count; i++) {
+		if (rfd.sector_map[i] !=3D -1)
+			break;
+	}
+
+	if (i =3D=3D rfd.sector_count) {
+		fprintf(stderr, "%s: no sectors found\n", rfd.mtd_filename);
+		goto err;
+	}
+
+	out_fd =3D open(rfd.out_filename, O_WRONLY | O_TRUNC | O_CREAT, 0666);
+	if (out_fd =3D=3D -1) {
