+			ADD_BYTES(n, ((je32_to_cpu(n->u.totlen) + 3) & ~3));
+		} else
+			n =3D (union jffs2_node_union *) o;	/* we're at the end, rewind to the =
beginning */
+
+		if (lr =3D=3D n) {			/* whole loop since last read */
+			vmax =3D vmaxt;
+			vmin =3D vmint;
+			vmint =3D ~((uint32_t) 0);
+
+			if (vcur < vmax && vcur < vmin) {
+				d =3D putdir(d, &(mp->d));
+
+				lr =3D n =3D
+					(union jffs2_node_union *) (((char *) mp) +
+							((je32_to_cpu(mp->u.totlen) + 3) & ~3));
+
+				vcur =3D vmin;
+			}
