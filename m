>>  	if (gpio_is_valid(gpiomtd->plat.gpio_nwp))
>>  		gpio_set_value(gpiomtd->plat.gpio_nwp, 0);
>> -	gpio_set_value(gpiomtd->plat.gpio_nce, 1);
>> +	if (gpio_is_valid(gpiomtd->plat.gpio_nce))
>> +		gpio_set_value(gpiomtd->plat.gpio_nce, 1);
>>
>>  	return 0;
