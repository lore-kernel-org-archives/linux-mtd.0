-				*++p =3D (uint8_t)(val >>=3D 8);
-				if (nrbits > 24) {
-					*++p =3D (uint8_t)(val >>=3D 8);
-					if (nrbits > 32)
-						*++p =3D (uint8_t)(val >>=3D 8);
-				}
-			}
-		}
-	} else {
-		*p =3D (uint8_t)val;
-		if (nrbits > 8) {
-			*++p =3D (uint8_t)(val >>=3D 8);
-			if (nrbits > 16) {
