+		if (n < e && je16_to_cpu(n->u.magic) =3D=3D JFFS2_MAGIC_BITMASK) {
+			if (je16_to_cpu(n->u.nodetype) =3D=3D JFFS2_NODETYPE_DIRENT &&
+				je32_to_cpu(n->d.pino) =3D=3D ino && (v =3D je32_to_cpu(n->d.version))=
