+				}
+				length =3D node->x.name_len + 1 + je16_to_cpu(node->x.value_len);
+				crc =3D mtd_crc32(0, node->x.data, length);
+				if (crc !=3D je32_to_cpu(node->x.data_crc)) {
+					warnmsg("Wrong data_crc at 0x%08zx, 0x%08x instead of 0x%08x\n",
+							p - file_buffer, je32_to_cpu(node->x.data_crc), crc);
