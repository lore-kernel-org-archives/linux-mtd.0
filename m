+	fprintf(stdout, "        0x%08x, /* rsize  */\n", raw_inode->rsize);
+	fprintf(stdout, "        0x%02x,       /* nsize  */\n", raw_inode->nsize)=
;
+	fprintf(stdout, "        0x%02x,       /* nlink  */\n", raw_inode->nlink)=
;
+	fprintf(stdout, "        0x%02x,       /* spare  */\n",
+			raw_inode->spare);
