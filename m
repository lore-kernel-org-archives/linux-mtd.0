+/* adds/removes directory node into dir struct. */
+/* reading all valid nodes in version order reconstructs the directory. */
+
+/*
+   dd      - directory struct being processed
+   n       - node
+
+   return value: directory struct value replacing dd
+ */
+
+struct dir *putdir(struct dir *dd, struct jffs2_raw_dirent *n)
+{
+	struct dir *o, *d, *p;
+
+	o =3D dd;
+
+	if (je32_to_cpu(n->ino)) {
+		if (dd =3D=3D NULL) {
+			d =3D xmalloc(sizeof(struct dir));
+			d->type =3D n->type;
+			memcpy(d->name, n->name, n->nsize);
+			d->nsize =3D n->nsize;
+			d->ino =3D je32_to_cpu(n->ino);
+			d->next =3D NULL;
+
+			return d;
+		}
+
+		while (1) {
+			if (n->nsize =3D=3D dd->nsize &&
+					!memcmp(n->name, dd->name, n->nsize)) {
+				dd->type =3D n->type;
+				dd->ino =3D je32_to_cpu(n->ino);
+
+				return o;
+			}
+
+			if (dd->next =3D=3D NULL) {
+				dd->next =3D xmalloc(sizeof(struct dir));
+				dd->next->type =3D n->type;
+				memcpy(dd->next->name, n->name, n->nsize);
+				dd->next->nsize =3D n->nsize;
+				dd->next->ino =3D je32_to_cpu(n->ino);
+				dd->next->next =3D NULL;
+
+				return o;
+			}
