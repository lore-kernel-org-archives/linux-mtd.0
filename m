+				mtd_filename);
+		close(fd);
+		return 2;
+	}
+
+	for (i=3D0; i<block_count; i++) {
+		struct erase_info_user erase_info;
+
+		erase_info.start =3D i * mtd_info.erasesize;
+		erase_info.length =3D mtd_info.erasesize;
+
+		if (ioctl(fd, MEMERASE, &erase_info) !=3D 0) {
+			snprintf(buf, sizeof(buf), "%s: erase", mtd_filename);
+			perror(buf);
+			close(fd);
+			return 2;
+		}
+
+		if (pwrite(fd, magic, sizeof(magic), i * mtd_info.erasesize)
+				!=3D sizeof(magic)) {
+			snprintf(buf, sizeof(buf), "%s: write", mtd_filename);
+			perror(buf);
+			close(fd);
+			return 2;
+		}
+	}
+
+	close(fd);
+
+	return 0;
+}
