POSE.\n",
+			PROGRAM_NAME);
+
+	exit(0);
+}
+
+void process_options(int argc, char *argv[], const char **mtd_filename)
+{
+	int error =3D 0;
+
+	for (;;) {
+		int option_index =3D 0;
+		static const char *short_options =3D "hV";
+		static const struct option long_options[] =3D {
+			{ "help", no_argument, 0, 'h' },
+			{ "version", no_argument, 0, 'V', },
+			{ NULL, 0, 0, 0 }
+		};
+
+		int c =3D getopt_long(argc, argv, short_options,
+				long_options, &option_index);
+		if (c =3D=3D EOF)
+			break;
+
+		switch (c) {
+			case 'h':
+				display_help();
+				break;
+			case 'V':
+				display_version();
+				break;
