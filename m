-static void cleanup(struct filesystem_entry *dir)
-{
-	struct filesystem_entry *e, *prev;
-
-	e =3D dir->files;
-	while (e) {
-		if (e->name)
-			free(e->name);
-		if (e->path)
-			free(e->path);
-		if (e->fullname)
-			free(e->fullname);
-		e->next =3D NULL;
-		e->name =3D NULL;
-		e->path =3D NULL;
-		e->fullname =3D NULL;
-		e->prev =3D NULL;
-		prev =3D e;
