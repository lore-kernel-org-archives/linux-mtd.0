+static int namecmp(const char *name1, const char *name2)
+{
+	size_t len1 =3D strlen(name1), len2 =3D strlen(name2);
+	size_t clen =3D (len1 < len2) ? len1 : len2;
+	int cmp;
+
+	cmp =3D memcmp(name1, name2, clen);
+	if (cmp)
+		return cmp;
+	return (len1 < len2) ? -1 : 1;
+}
