+	if (len > c->leb_size - head_offs) {
+		err =3D flush_nodes();
+		if (err)
+			return err;
+	}
+	*lnum =3D head_lnum;
+	*offs =3D head_offs;
+	head_offs +=3D ALIGN(len, 8);
+	return 0;
