+	k =3D inum % HASH_TABLE_SIZE;
+	im =3D hash_table[k];
+	while (im) {
+		if (im->dev =3D=3D dev && im->inum =3D=3D inum)
+			return im;
+		im =3D im->next;
+	}
+	im =3D malloc(sizeof(struct inum_mapping));
+	if (!im)
