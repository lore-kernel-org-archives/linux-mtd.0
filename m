+
+	vmin =3D 0;					/* next to read */
+	vmax =3D ~((uint32_t) 0);		/* last to read */
+	vmint =3D ~((uint32_t) 0);
+	vmaxt =3D 0;					/* found maximum */
+	vcur =3D 0;					/* XXX what is smallest version number used? */
+	/* too low version number can easily result excess log rereading */
