 						unsigned int reg_index, bool bbm, int page,
 						unsigned int user_data_sz)
@@ -1377,30 +1407,32 @@ static int sunxi_nfc_hw_ecc_read_chunk(struct nand_chip *nand,
 					     pattern_found, step, 1);
 }
 
