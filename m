+static uint32_t ino =3D 0;
+static uint8_t *file_buffer =3D NULL;		/* file buffer contains the actual =
erase block*/
+static int out_ofs =3D 0;
+static int erase_block_size =3D 65536;
+static int pad_fs_size =3D 0;
+static int add_cleanmarkers =3D 1;
+static struct jffs2_unknown_node cleanmarker;
+static int cleanmarker_size =3D sizeof(cleanmarker);
+static unsigned char ffbuf[16] =3D
+{ 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
+	0xff, 0xff, 0xff, 0xff, 0xff
+};
