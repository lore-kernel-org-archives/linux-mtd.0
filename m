+	im->next =3D hash_table[k];
+	im->prev =3D NULL;
+	im->dev =3D dev;
+	im->inum =3D inum;
+	im->use_inum =3D 0;
+	im->use_nlink =3D 0;
+	if (hash_table[k])
+		hash_table[k]->prev =3D im;
+	hash_table[k] =3D im;
+	return im;
