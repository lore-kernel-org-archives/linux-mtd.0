+	for (i=3D0; i<rfd->data_sectors; i++) {
+		uint16_t entry =3D le16_to_cpu(rfd->header[i + HEADER_MAP_OFFSET]);
+
+		if (entry =3D=3D SECTOR_FREE || entry =3D=3D SECTOR_DELETED)
+			continue;
