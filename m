>> +			gpio_set_value(gpiomtd->plat.gpio_nce,
>> +				       !(ctrl & NAND_NCE));
>>  		gpio_set_value(gpiomtd->plat.gpio_cle, !!(ctrl & NAND_CLE));
>>  		gpio_set_value(gpiomtd->plat.gpio_ale, !!(ctrl & NAND_ALE));
