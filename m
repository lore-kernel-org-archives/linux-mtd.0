+			dd =3D dd->next;
+		}
+	} else {
+		if (dd =3D=3D NULL)
+			return NULL;
+
+		if (n->nsize =3D=3D dd->nsize && !memcmp(n->name, dd->name, n->nsize)) {
+			d =3D dd->next;
+			free(dd);
+			return d;
+		}
+
+		while (1) {
+			p =3D dd;
+			dd =3D dd->next;
+
+			if (dd =3D=3D NULL)
+				return o;
+
+			if (n->nsize =3D=3D dd->nsize &&
+					!memcmp(n->name, dd->name, n->nsize)) {
